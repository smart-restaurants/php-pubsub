{
  "name": "smart-restaurants/php-pubsub",
  "description": "Библиотека для реализаций паттерна Pub/Sub (форк chocofamilyme/pubsub с поддержкой heartbeat и расширенных параметров AMQP-подключения).",
  "keywords": [
    "pubsub",
    "phalcon",
    "events",
    "microservice",
    "eventsource",
    "rabbitmq",
    "amqp"
  ],
  "type": "library",
  "license": [
    "BSD-3-Clause"
  ],
  "homepage": "https://github.com/smart-restaurants/php-pubsub",
  "support": {
    "issues": "https://github.com/smart-restaurants/php-pubsub/issues",
    "source": "https://github.com/smart-restaurants/php-pubsub"
  },
  "authors": [
    {
      "name": "IT Chocolife.me",
      "homepage": "https://chocolife.me/"
    },
    {
      "name": "Smart Restaurants",
      "homepage": "https://github.com/smart-restaurants"
    }
  ],
  "require": {
    "php": ">= 7.0.0",
    "chocofamilyme/pathcorrelation": "0.2.*",
    "php-amqplib/php-amqplib": "^2.10",
    "ext-phalcon": ">= 3.0.0"
  },
  "require-dev": {
    "codeception/codeception": "*"
  },
  "replace": {
    "chocofamilyme/pubsub": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Chocofamily\\": "src/"
    }
  }
}
